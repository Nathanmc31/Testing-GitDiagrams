  ~ citationId: String
  ~ citationItems: List<CitationItemData>
  + CSL_CITATION_SCHEMA: String
  ~ schema: String
  - blankToNull(String): String?
}
class ZoteroCitationLinker {
  ~ linkReferenceMark(String, BibDatabaseContext, BibEntryTypesManager): String
  - createJabRefUriForZotero(CitationItemData, BibDatabaseContext, DuplicateCheck): Optional<String>
  - updateReferenceMarkName(XTextDocument, String, String): void
  + linkZoteroCitations(XTextDocument, BibDatabaseContext, BibEntryTypesManager): int
  - findDuplicate(BibEntry, BibDatabaseContext, DuplicateCheck): Optional<BibEntry>
}
class ZoteroCitationMarkParser {
  - GSON: Gson
  - LOGGER: Logger
  - setField(BibEntry, Field, String): void
  + parseCslJsonItems(String): List<BibEntry>
  - toBibEntry(ItemData): Optional<BibEntry>
  - setDate(BibEntry, IssuedData): void
  - setAuthors(List<AuthorData>): Optional<String>
  + parseCslCitationJson(String): List<BibEntry>
  + toBibEntry(CitationItemData): Optional<BibEntry>
}
class ZoteroDocumentPreferences {
  - STYLE: String
  - EMPTY_XML_DOCUMENT_DATA: String
  - ZOTERO_PREF: String
  - CSL_PREF: String
  - STYLE_ID: String
  - LOGGER: Logger
  - MAX_LENGTH: int
  + findCitationStyle(XTextDocument, List<CitationStyle>): Optional<CitationStyle>
  - getOrCreateXmlStyleElement(Document): Element
  - getChunkIndex(String, String): Optional<Integer>
  - removeTrailingChunks(XTextDocument, String, int): void
  - serializeXmlDocument(Document): String
  - writeProperty(XTextDocument, String, String): void
  - createOrUpdatePrefWithStyleId(String, String): String
  + writeCitationStyle(XTextDocument, CitationStyle): boolean
  ~ findStyleId(String): Optional<String>
  - readSerializedData(XTextDocument): Optional<String>
  - readChunkedProperty(XTextDocument, String): Optional<String>
  - buildXmlDocument(String): Document
}
entity ZoteroReferenceMark << record >> {
  - RANDOM_PREFIX: String
  - LOGGER: Logger
  - RANDOM_LENGTH: int
  - ITEM_ID_PATTERN: Pattern
  - citationNumbers: List<Integer>
  - ZOTERO_URI_PREFIX: String
  - RANDOM_SUFFIX_PATTERN: Pattern
  - JABREF_URI_PREFIX: String
  - uniqueId: String
  - CITATION_ID_LENGTH: int
  - GSON: Gson
  - name: String
  - citationKeys: List<String>
  + PREFIX: String
  - citationType: CSLCitationType
  - getCitationData(String): ZoteroCitationData
  - getSuffix(String): String
  - normalizeZoteroItemId(String): String
  + buildReferenceMark(List<BibEntry>, List<String>, List<Integer>, int, CSLCitationType, BibDatabaseContext, BibEntryTypesManager, Map<String, String>): ZoteroReferenceMark
  ~ isZoteroUri(String): boolean
  + parse(String): Optional<ZoteroReferenceMark>
  ~ createRandomSuffix(): String
  ~ isJabRefUri(String): boolean
  + citationType(): CSLCitationType
  - createUris(String, String): List<String>
  + updateCitationType(String, CSLCitationType): String
  ~ getCitationItems(String): List<CitationItemData>
  ~ getCitationKey(CitationItemData): Optional<String>
  + name(): String
  + isZoteroReferenceMarkName(String): boolean
  + extractZoteroUriByCitationKey(String): Map<String, String>
  ~ createJabRefUri(String): String
  + getCSLJson(String): String
  + getMaxItemId(String): int
  + uniqueId(): String
  ~ getCitationKeyFromJabRefUri(String): String
  + citationKeys(): List<String>
  + citationNumbers(): List<Integer>
  ~ addJabRefUri(String, int, String): String
}

